includes:
	- phpstan-baseline.neon

parameters:

	level: 8

	paths:
		- src

	bootstrapFiles:
		- vendor/pimcore/pimcore/stubs/dynamic-constants.php

	reportIgnoresWithoutComments: true

	# `LegacyPimcoreInstaller` extends Pimcore's `Installer`, which is `final` on ^2026.1 - a
	# `class.extendsFinal` error PHPStan refuses to let us ignore. Only valid against Pimcore 11/12 -
	# see phpstan.neon, which excludes PimcoreDatabaseInstaller.php instead.
	excludePaths:
		- src/Database/LegacyPimcoreInstaller.php

	ignoreErrors:
		-
			identifier: trait.unused
			paths:
				- src/Database/ResetDatabase.php
				- src/Pimcore/*
		-
			# `LegacyPimcoreInstaller` (excluded above) only implements `setupDatabase()` against Pimcore
			# 11/12's `Installer` API - this call is only reached on that version, never on ^2026.1.
			message: '#^Call to an undefined method Neusta\\Pimcore\\TestingFramework\\Database\\LegacyPimcoreInstaller\:\:setupDatabase\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Database/PimcoreDatabaseResetter.php
		-
			# pimcore/admin-ui-classic-bundle isn't installable alongside ^2026.1 at all - it's
			# required for 11/12 (see phpstan.neon, which analyses this repo against those versions).
			message: '#^Parameter \#1 \$bundle of method Pimcore\\HttpKernel\\BundleCollection\\BundleCollection\:\:addBundle\(\) expects string\|Symfony\\Component\\HttpKernel\\Bundle\\BundleInterface, Pimcore\\Bundle\\AdminBundle\\PimcoreAdminBundle given\.$#'
			identifier: argument.type
			count: 1
			path: src/Kernel/TestKernel.php
