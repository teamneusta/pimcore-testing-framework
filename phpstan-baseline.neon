parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#2 \$registry of class Neusta\\Pimcore\\TestingFramework\\Internal\\Database\\PimcoreDatabaseResetter constructor expects Doctrine\\Persistence\\ManagerRegistry, object given\.$#'
			identifier: argument.type
			count: 1
			path: src/Internal/Database/DatabaseResetter.php

		-
			message: '#^Method Neusta\\Pimcore\\TestingFramework\\Internal\\Database\\RunCommand\:\:__invoke\(\) has parameter \$parameters with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Internal/Database/RunCommand.php

		-
			message: '#^Parameter \#1 \$name of static method Neusta\\Pimcore\\TestingFramework\\BootstrapPimcore\:\:setEnv\(\) expects string, int\<0, max\>\|string given\.$#'
			identifier: argument.type
			count: 1
			path: src/BootstrapPimcore.php

		-
			# parent::configureContainer() only has one parameter since Symfony 7.4.9 (resolved on
			# Pimcore ^12.0/^2026.1); on older Symfony (resolved on Pimcore ^11.5) it still has three,
			# so this error - and thus this ignore - is version-dependent.
			message: '#^Method Pimcore\\Kernel\:\:configureContainer\(\) invoked with 3 parameters, 1 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/TestKernel.php
			reportUnmatched: false

		-
			# doctrine/dbal ^3.x's Configuration::getSchemaAssetsFilter() is nullable; ^4.x always has
			# a default filter, making the null-check statically dead code there. Both DBAL major
			# versions are supported (see composer.json), and which one gets resolved depends on the
			# Pimcore version, not just "highest vs. lowest".
			message: '#^Strict comparison using \!\=\= between null and callable\(\)\: mixed will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Internal/Database/DoctrineSchemaAssetFilter.php
			reportUnmatched: false

		-
			# The PHPUnit 9 vs 10+ switch in AttributeProvider: exactly one side of each `method_exists()`
			# exists per installed PHPUnit major, so whichever side is missing is reported - and which one
			# that is depends on the PHPUnit version resolved (see composer.json: ^9.6 || ^10.5 || ^11.5).
			message: '#^Call to an undefined method PHPUnit\\Framework\\TestCase\:\:(name|providedData)\(\)\.$#'
			identifier: method.notFound
			path: src/Internal/AttributeProvider.php
			reportUnmatched: false

		-
			# Same switch seen from the other side: on PHPUnit 9 the `method_exists()` guards are provably
			# true, on PHPUnit 10+ they are provably false. Only reported on the former.
			message: '#^Call to function method_exists\(\) with PHPUnit\\Framework\\TestCase and ''(getName|getProvidedData)'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			path: src/Internal/AttributeProvider.php
			reportUnmatched: false

